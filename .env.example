# Copy to .env and fill in. Never commit the real file.
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Local database started with `docker compose up -d db` (published on host port 5433).
POSTGRES_USER=kuzahealth
POSTGRES_PASSWORD=local-development-only

# Used when running the app outside Docker. Inside docker compose these are set for you.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/kuzahealth
SPRING_DATASOURCE_USERNAME=kuzahealth
SPRING_DATASOURCE_PASSWORD=local-development-only

# base64 string that decodes to at least 32 bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=
# access token lifetime in seconds
JWT_EXPIRATION=604800

SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=

PINDO_TOKEN=
PINDO_SENDER=PindoTest

# Optional: create the first administrator on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false to allow only administrators to create accounts
OPEN_REGISTRATION=true
